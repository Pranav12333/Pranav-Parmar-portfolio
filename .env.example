# .env.example
#
# Copy to `.env.local` for local overrides. Nothing in this file is required to
# run the site — `npm install && npm run dev` works with no env at all.

# Deploy base path. Set automatically by the GitHub Pages workflow; leave unset
# locally and on Vercel so the base stays "/".
# BASE_PATH=/Pranav-Parmar-portfolio/

# Set to 1 to build without the identifier/string mangling pass in
# build/mangle-plugin.ts (useful when reading a production stack trace).
# NO_MANGLE=1

# Content provider selection. Only "static-bundled" is implemented; the remote
# providers are behind the `remoteContent` gate.
# CONTENT_PROVIDER=static-bundled

# Analytics sink id. Empty means no sink is attached (the default).
# ANALYTICS_SINK=
